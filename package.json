{
  "name": "create-hearth",
  "version": "0.6.0-beta.2",
  "description": "One-command installer and lifecycle CLI for the Hearth human-agent collaboration hub",
  "type": "module",
  "bin": {
    "create-hearth": "cli/create-hearth.mjs",
    "hearth": "cli/hearth.mjs"
  },
  "files": [
    ".env.example",
    "cli/",
    "config/",
    "docs/",
    "mcp/matrix/index.mjs",
    "mcp/matrix/package.json",
    "mcp/matrix/package-lock.json",
    "mcp/memory/app.py",
    "mcp/memory/work.py",
    "mcp/memory/commons_files.py",
    "mcp/memory/glossary.py",
    "mcp/memory/journal.py",
    "integrations/commons/",
    "mcp/memory/dashboard.py",
    "mcp/memory/coordination.py",
    "mcp/memory/inbox_ack.py",
    "mcp/memory/reviewers.py",
    "mcp/memory/dashboard-watchers.json",
    "mcp/memory/Dockerfile",
    "mcp/memory/requirements.txt",
    "mcp/memory/static/",
    "docker-compose*.yml",
    "LICENSE",
    "PROJECT.md",
    "README.md"
  ],
  "scripts": {
    "test:glossary": "node --test --test-concurrency=1 test/glossary-browser.test.mjs test/commons-connected.test.mjs",
    "test:journal": "node --test --test-concurrency=1 test/journal-browser.test.mjs test/journal-connected.test.mjs",
    "check": "node --check cli/hearth.mjs && node --check cli/create-hearth.mjs && node --check mcp/matrix/index.mjs && node --check mcp/memory/static/app.js && node --check mcp/memory/static/work.js && node --check mcp/memory/static/slice.js",
    "test:dashboard": "node --test test/dashboard-slice.test.mjs",
    "test": "node --test test/cli.test.mjs test/matrix-mcp.test.mjs test/notify.test.mjs test/commons-client.test.mjs test/commons-turn.test.mjs test/journal-turn.test.mjs test/commons-runtime-patches.test.mjs",
    "prepublishOnly": "npm run check && npm test",
    "test:py": "python -m unittest discover -s test -p \"test_*.py\""
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RadekalOne/hearth.git"
  },
  "bugs": {
    "url": "https://github.com/RadekalOne/hearth/issues"
  },
  "homepage": "https://github.com/RadekalOne/hearth#readme",
  "keywords": [
    "ai-agents",
    "matrix",
    "mcp",
    "multi-agent",
    "self-hosted"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "axe-core": "4.14.0",
    "playwright": "^1.62.1"
  }
}
